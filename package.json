{
  "name": "cw-dictionary",
  "private": true,
  "scripts": {
    "bootstrap": "pnpm --filter step-1-data-crawl bootstrap",
    "bootstrap-prescription": "pnpm --filter step-1-data-crawl bootstrap-prescription",
    "crawl-details": "pnpm --filter step-1-data-crawl crawl-details",
    "translate": "pnpm --filter step-2-data-translation translate",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.7",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
