{
  "name": "cw-dictionary",
  "private": true,
  "scripts": {
    "bootstrap": "pnpm --filter step-1-data-crawl bootstrap",
    "bootstrap-prescription": "pnpm --filter step-1-data-crawl bootstrap-prescription",
    "crawl-details": "pnpm --filter step-1-data-crawl crawl-details",
    "export-collection-tree": "pnpm --filter step-1-data-crawl export-collection-tree",
    "complete-product-collections": "pnpm --filter step-1-data-crawl complete-product-collections",
    "translate": "pnpm --filter step-2-data-translation translate",
    "translate-collections": "pnpm --filter step-2-data-translation translate-collections",
    "generate-schema": "pnpm --filter step-3-data-migration generate-schema",
    "migrate:products": "pnpm --filter step-3-data-migration migrate:products",
    "migrate:product-translations": "pnpm --filter step-3-data-migration migrate:product-translations",
    "migrate:collections": "pnpm --filter step-3-data-migration migrate:collections",
    "migrate:collection-translations": "pnpm --filter step-3-data-migration migrate:collection-translations",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.7",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
